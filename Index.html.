<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ELLA PRIME - LUXE DARK NEON</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;600&family=Inter:wght@300&display=swap" rel="stylesheet">
<style>
  :root{ --bg:#000; --card:#0a0a0a; --rosa:#F8C6D0; --rosa-light:#FFB6D9; --text:#fff; --text2:#aaa; }
  body.light{ --bg:#FFFFFF; --card:#FFFFFF; --text:#000; --text2:#666; }
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;transition:0.4s}
  .neon{color:var(--rosa);text-shadow:0 0 7px var(--rosa),0 0 18px var(--rosa-light)}
  .neon-box{border:1.5px solid var(--rosa);box-shadow:0 0 12px var(--rosa), inset 0 0 8px rgba(248,198,208,0.2);border-radius:16px}
  header{display:flex;justify-content:space-between;align-items:center;padding:20px}
  .logo{font-family:'Cormorant Garamond',serif;font-size:34px;letter-spacing:2px}
  .toggle{cursor:pointer;border:1px solid var(--rosa);padding:6px 12px;border-radius:20px;font-size:12px}
  .search{margin:20px;padding:14px;text-align:left;display:flex;gap:10px;align-items:center}
  .search input{background:transparent;border:none;outline:none;color:var(--text);width:100%}
  .catalog-title{display:flex;justify-content:space-between;padding:20px 20px 10px;align-items:center}
  .catalog-title h2{font-size:24px;letter-spacing:3px}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 12px 100px}
  .card{background:var(--card);padding:10px;text-align:center;border-radius:16px;transition:0.3s}
  .card .img{height:180px;background:#111;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#555;font-size:10px}
  body.light .card .img{background:#f5f5f5}
  .card h3{font-size:11px;letter-spacing:1.5px;margin:10px 0 4px}
  .card p{font-size:9px;color:var(--text2)}
  .precio{margin:8px 0;color:var(--rosa);font-weight:700;text-shadow:0 0 6px var(--rosa)}
  .btn{display:block;border:1px solid var(--rosa);color:var(--rosa);padding:8px;text-decoration:none;font-size:10px;letter-spacing:2px;border-radius:20px;box-shadow:0 0 8px var(--rosa)}
  .nav{position:fixed;bottom:15px;left:12px;right:12px;background:var(--card);display:flex;justify-content:space-around;padding:14px;border-radius:20px}
  .nav span{font-size:10px;text-align:center;display:block}
</style>
</head>
<body>
<header>
  <div class="logo neon">ELLA PRIME</div>
  <div class="toggle neon-box" onclick="document.body.classList.toggle('light')">☀️ / 🌙</div>
</header>

<div class="search neon-box" style="margin:0 20px">
  <span>🔍</span><input placeholder="Buscar palazzo, bodysuit, sweater...">
</div>

<div class="catalog-title">
  <h2 class="neon">CATALOG</h2>
  <div style="font-size:10px;color:var(--text2)">6 ITEMS</div>
</div>

<div class="grid">
  <div class="card neon-box">
    <div class="img">FOTO REAL</div>
    <h3>SWEATER NEGRO LACE</h3><p>Talle S</p><div class="precio">$24.000</div>
    <a class="btn" href="https://wa.me/5491161080941?text=Hola!%20Quiero%20SWEATER%20NEGRO%20LACE%20S%20$24.000">ADD TO BAG</a>
  </div>
  <div class="card neon-box">
    <div class="img">FOTO REAL</div>
    <h3>PALAZZO ENGOMADO</h3><p>Talle 2 - con cinto</p><div class="precio">$36.500</div>
    <a class="btn" href="https://wa.me/5491161080941?text=Hola!%20Quiero%20PALAZZO%20ENGOMADO%20T2%20$36.500">ADD TO BAG</a>
  </div>
  <div class="card neon-box">
    <div class="img">FOTO REAL</div>
    <h3>TOP NEGRO</h3><p>Talle S</p><div class="precio">$30.000</div>
    <a class="btn" href="https://wa.me/5491161080941?text=Hola!%20Quiero%20TOP%20NEGRO%20S%20$30.000">ADD TO BAG</a>
  </div>
  <div class="card neon-box">
    <div class="img">FOTO REAL</div>
    <h3>CONJ VERDE ESMERALDA</h3><p>Talle 2</p><div class="precio">$18.500</div>
    <a class="btn" href="https://wa.me/5491161080941?text=Hola!%20Quiero%20CONJ%20VERDE%20ESMERALDA%20T2%20$18.500">ADD TO BAG</a>
  </div>
  <div class="card neon-box">
    <div class="img">FOTO REAL</div>
    <h3>SHORT NEGRO</h3><p>Talle M - sin frunce</p><div class="precio">$22.000</div>
    <a class="btn" href="https://wa.me/5491161080941?text=Hola!%20Quiero%20SHORT%20NEGRO%20M%20$22.000">ADD TO BAG</a>
  </div>
  <div class="card neon-box">
    <div class="img">FOTO REAL HOY</div>
    <h3>CONJ BATIK OLIVA</h3><p>Talle 2</p><div class="precio">$27.000</div>
    <a class="btn" href="https://wa.me/5491161080941?text=Hola!%20Quiero%20CONJ%20BATIK%20OLIVA%20T2%20$27.000">ADD TO BAG</a>
  </div>
</div>

<div class="nav neon-box">
  <div><div>🏠</div><span>Home</span></div>
  <div><div>🛍️</div><span class="neon">Catalog</span></div>
  <div><div>👜</div><span>Cart</span></div>
  <div><div>❤️</div><span>Fav</span></div>
  <div><div>👤</div><span>Profile</span></div>
</div>
</body>
</html>
